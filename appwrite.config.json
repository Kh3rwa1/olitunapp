{
    "projectId": "699495910038e39622c5",
    "functions": [
        {
            "$id": "6a007db60024418c0997",
            "name": "translator",
            "runtime": "node-22",
            "path": "functions/translator",
            "entrypoint": "src/main.js",
            "execute": [
                "any"
            ],
            "enabled": true,
            "logging": true,
            "events": [],
            "schedule": "",
            "timeout": 15,
            "commands": "npm install",
            "scopes": [
                "users.read"
            ]
        },
        {
            "$id": "delete-account",
            "name": "delete-account",
            "runtime": "node-22",
            "path": "functions/delete-account",
            "entrypoint": "src/main.js",
            "execute": [
                "users"
            ],
            "enabled": true,
            "logging": true,
            "events": [],
            "schedule": "",
            "timeout": 15,
            "commands": "npm install",
            "scopes": [
                "users.write"
            ]
        }
    ],
    "sites": [
        {
            "$id": "69b2342a00065864275b",
            "name": "olitunapp",
