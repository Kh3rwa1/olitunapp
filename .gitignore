*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# --- IntelliJ / editors ------------------------------------------------------
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# --- Flutter / Dart / Pub ----------------------------------------------------
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
build/
/coverage/
app.*.symbols
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# --- Security ----------------------------------------------------------------
.env
cookies.txt
*.cookies
*cookie*.txt
run.sh
*.jks
*.keystore
android/key.properties
android/upload-keystore.jks
android/app/upload_certificate.pem
.keys/
.premium-content-rollback/

# `node_modules/` matches at any depth, so the nested overrides are redundant.
node_modules/

# --- Agent / AI --------------------------------------------------------------
.agent/
.gemini/scratch/

# --- Test artifacts ----------------------------------------------------------
coverage/
test_hive_cache/
test_hive_*/
project_sdk_dump.json
output/
**/failures/*.png

# --- Migration backups -------------------------------------------------------
scripts/backups/

# --- Release artifacts (built locally, never committed) ----------------------
# Globally ignored so a stray export cannot re-enter the repo root.
*.apk
*.aab
*.ipa
*.zip
*.tar
*.tar.gz
*.tgz
mapping.txt
sites/
build_web_v*.zip

# --- iOS ephemeral tooling (generated per-machine) ---------------------------
ios/Flutter/ephemeral/

