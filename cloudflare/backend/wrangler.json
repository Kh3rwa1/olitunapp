{
  "name": "olitun-api",
  "main": "src/index.ts",
  "compatibility_date": "2024-10-11",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "olitun-db",
      "database_id": "480d39c3-b132-4fdd-a02e-5671775584ff"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ASSETS",
      "bucket_name": "olitun-assets"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "APPWRITE_ENDPOINT": "https://sgp.cloud.appwrite.io/v1",
    "APPWRITE_PROJECT_ID": "699495910038e39622c5",
    "ADMIN_TEAM_ID": "admins"
  },
  "ratelimits": [
    {
      "name": "AI_USER_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "AI_IP_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ]
}
