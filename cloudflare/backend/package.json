{
  "name": "olitun-api",
  "version": "1.0.0",
  "description": "High-performance Cloudflare Worker backend for Olitun with D1, R2, and Edge Caching",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "db:migrate": "wrangler d1 execute olitun-db --remote --file=./schema.sql",
    "db:seed": "node seed.js"
  },
  "dependencies": {
    "hono": "^4.7.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@cloudflare/workers-types": "5.20261006.1",
    "@vitest/runner": "4.1.11",
    "@vitest/snapshot": "4.1.11",
    "typescript": "^5.6.3",
    "vitest": "4.1.11",
    "wrangler": "^4.75.0"
  },
  "overrides": {
    "sharp": "0.35.5",
    "undici": "7.29.1"
  }
}
